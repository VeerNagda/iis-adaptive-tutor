# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
# Leave GEMINI_API_KEY empty to run in mock mode.
GEMINI_API_KEY=
# Set to Mock to force mock mode even when a key is present.
LLM_PROVIDER=Auto

# Which Gemini model to use, and which to fall back to (comma-separated, in order).
# Every model has its own free-tier limits (requests per minute and per day). When one
# is used up, overloaded or does not answer, the next one in the list is tried.
# Copy the exact model IDs from the model list in Google AI Studio. A model with
# a higher daily limit (for example a "Flash Lite") is a good fallback. Fallback models
# must accept images, because pictures are described during ingestion.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=
# true: after the models above, also try the suitable "flash" models Gemini lists for your
# key (Flash Lite first). A model with no quota left is skipped within a second. If your key
# has billing turned on, the models it falls back to are charged, so set false to prevent that.
GEMINI_AUTO_FALLBACK=true

# Auto-ingest: if true, uploaded files are ingested automatically in the background.
# WARNING: it checks every 30 seconds and retries failed files, so it can use up your
# AI credits quickly. Recommended: keep it false and click "Ingest" on a file after
# uploading it.
AUTO_INGEST=false
